  "hide": {
    "_help": "Events whose title matches any of these patterns (case doesn't matter) are left out. Add a word or phrase to hide more.",
    "patterns": [
      "free parking",
      "closed for",
      "^closed\\b",
      "office hours",
      "registration (?:deadline|opens|closes)",
      "^(?:rock ?'?n'? ?bowl|blue moon saloon|hideaway on lee|feed (?:n|and|&) seed)[^a-z]*(?:de lafayette)?[^a-z]*(?:lafayette,? la\\.?)?$",
      "\\bonline\\b",
      "\\bvirtual\\b",
      "\\bzoom\\b",
      "medicare",
      "\\binsurance\\b",
      "benefits? (?:meeting|seminar|enrollment)",
      "client appreciation",
      "\\brealty\\b",
      "\\bmeeting\\b",
      "networking",
      "seminar",
      "webinar",
      "info(?:rmation)? session",
      "black friday",
      "cyber monday",
      "open house",
      "job fair",
      "career fair",
      "\\bthe little gym\\b",
      "\\bsteam camp\\b",
      "ribbon cutting",
      "luncheon",
      "savings",
      "\\bsale\\b",
      "\\bclearance\\b",
      "grand opening",
      "weekend pass"
    ]
  },
